# ═══════════════════════════════════════════════════════════════════════════════
# .env.example — Aegis AI SDK — Full Environment Variable Reference
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
#
# Priority (highest first):
#   Process env vars > .env > envs/.env.{AEGIS_ENV} > defaults
# ═══════════════════════════════════════════════════════════════════════════════

# ── Environment selection ─────────────────────────────────────────────────────
AEGIS_ENV=development            # development | staging | production

# ── External Identity Provider ────────────────────────────────────────────────
# The Gateway delegates credential validation to this URL.
# Development: run the mock IdP first:
#   uvicorn mocks.mock_idp_server:app --port 9000
# Production: set to your real corporate IdP
EXTERNAL_IDP_URL=http://localhost:9000    # dev mock
# EXTERNAL_IDP_URL=https://mycompany.com  # production

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
WORKERS=1                        # Gunicorn worker count (default: CPU cores)
LOG_LEVEL=info                   # debug | info | warning | error | critical

# ── GCP ───────────────────────────────────────────────────────────────────────
AEGIS__GCP__USE_GCP=false                          # Set true for staging/production
AEGIS__GCP__PROJECT_ID=your-gcp-project-id
AEGIS__GCP__LOCATION=us-central1
AEGIS__GCP__SECRET_MANAGER_PREFIX=aegis            # Prepended to all secret names

# Application Default Credentials (development only — use Workload Identity in prod)
GOOGLE_APPLICATION_CREDENTIALS=               # Leave empty to use ADC / metadata server

# ── JWT ───────────────────────────────────────────────────────────────────────
# Development: use local PEM files (generated by scripts/gen_keys.sh)
AEGIS__JWT__LOCAL_PRIVATE_KEY_PATH=keys/dev_private_key.pem
AEGIS__JWT__LOCAL_PUBLIC_KEY_PATH=keys/dev_public_key.pem

# Staging/Production: secret names in GCP Secret Manager (no PEM values here!)
AEGIS__JWT__PRIVATE_KEY_SECRET_NAME=aegis-jwt-private-key
AEGIS__JWT__PUBLIC_KEY_SECRET_NAME=aegis-jwt-public-key

AEGIS__JWT__ALGORITHM=RS256
AEGIS__JWT__ACCESS_TOKEN_EXPIRY_MINUTES=60
AEGIS__JWT__REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
AEGIS__RATE_LIMIT__BACKEND=memory              # memory | redis
AEGIS__RATE_LIMIT__REDIS_URL=redis://localhost:6379/0
AEGIS__RATE_LIMIT__REQUESTS_PER_MINUTE=60
AEGIS__RATE_LIMIT__BURST_MULTIPLIER=2.0
AEGIS__RATE_LIMIT__USE_IN_MEMORY_FALLBACK=true # Redis fallback (dev only)

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# Development: set here
# Staging/Production: load from GCP Secret Manager
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...

# ── GuardRails ────────────────────────────────────────────────────────────────
AEGIS__GUARDRAILS__INJECTION_THRESHOLD=0.7
AEGIS__GUARDRAILS__TOXICITY_THRESHOLD=0.6
AEGIS__GUARDRAILS__PII_CONFIDENCE_THRESHOLD=0.85
AEGIS__GUARDRAILS__FAIL_OPEN=false             # MUST be false in production

# ── Audit ─────────────────────────────────────────────────────────────────────
AEGIS__AUDIT__USE_GCP_LOGGING=false            # Set true in staging/production
AEGIS__AUDIT__USE_STRUCTURED_STDOUT=true
AEGIS__AUDIT__SIGNING_KEY_SECRET_NAME=aegis-audit-hmac-key
AEGIS__AUDIT__RETENTION_DAYS=90

# Splunk HEC (optional — production only)
SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector/event
SPLUNK_HEC_TOKEN_SECRET_NAME=aegis-splunk-hec-token

# ── Encryption ────────────────────────────────────────────────────────────────
AEGIS__ENCRYPTION__KEY_CACHE_TTL_SECONDS=300
AEGIS__ENCRYPTION__KEY_ROTATION_DAYS=90

# ── TLS ───────────────────────────────────────────────────────────────────────
AEGIS__TLS__MINIMUM_VERSION=TLSv1.2           # TLSv1.3 required in production
AEGIS__TLS__VERIFY_CERTIFICATES=true

# ── Secret Backend ────────────────────────────────────────────────────────────
# Resolved automatically from AEGIS_ENV:
#   development → env
#   staging / production → gcp
# Override only if needed:
# AEGIS__SECRET_BACKEND=env

# ── HTTP Server (Allowed Hosts / CORS) ───────────────────────────────────────
ALLOWED_HOSTS=*                               # Comma-separated; * = any (dev only)
CORS_ORIGINS=                                 # Comma-separated origins (empty = none)

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis-ai
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0                   # Use 0.1 (10%) in production

# ── MFA ───────────────────────────────────────────────────────────────────────
AEGIS__MFA__REQUIRE_MFA=false                 # Set true in production
AEGIS__MFA__TOTP_ISSUER=Aegis-AI
