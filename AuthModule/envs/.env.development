# ─────────────────────────────────────────────────────────────────────────────
# aegis-ai · DEVELOPMENT Environment
# ─────────────────────────────────────────────────────────────────────────────
# Purpose : Local developer workstation. No GCP required.
# Usage   : cp envs/.env.development .env  (or set AEGIS_ENV=development)
# WARNING : NEVER use these values in staging or production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment Identity ──────────────────────────────────────────────────────
AEGIS__ENVIRONMENT=development
AEGIS__PIPELINE__ENVIRONMENT=development
AEGIS__LOG_LEVEL=DEBUG

# ── GCP (disabled — no cloud creds required locally) ──────────────────────────
AEGIS__GCP__USE_GCP=false
AEGIS__GCP__PROJECT_ID=local-dev-project
AEGIS__GCP__SERVICE_ACCOUNT_PATH=
AEGIS__GCP__SECRET_MANAGER_PREFIX=aegis-ai-dev
AEGIS__GCP__KMS_KEY_RING=aegis-ai-dev-keyring
AEGIS__GCP__KMS_LOCATION=global
AEGIS__GCP__KMS_CRYPTO_KEY=aegis-ai-dev-key

# ── JWT (local PEM files — generate with: scripts/gen_rsa_keys.sh) ────────────
AEGIS__JWT__ALGORITHM=RS256
AEGIS__JWT__ISSUER=http://localhost:8000
AEGIS__JWT__AUDIENCE=aegis-ai-dev
AEGIS__JWT__ACCESS_TOKEN_EXPIRE_MINUTES=60
AEGIS__JWT__REFRESH_TOKEN_EXPIRE_DAYS=30
AEGIS__JWT__LOCAL_PRIVATE_KEY_PATH=./keys/dev_private_key.pem
AEGIS__JWT__LOCAL_PUBLIC_KEY_PATH=./keys/dev_public_key.pem
AEGIS__JWT__PRIVATE_KEY_SECRET_NAME=aegis-jwt-private-key-dev
AEGIS__JWT__PUBLIC_KEY_SECRET_NAME=aegis-jwt-public-key-dev

# ── OIDC / SSO (optional in dev) ─────────────────────────────────────────────
# Uncomment to test SSO locally with a dev OIDC provider (e.g. Keycloak)
# AEGIS__OIDC__PROVIDER_NAME=google
# AEGIS__OIDC__CLIENT_ID=dev-client-id
# AEGIS__OIDC__CLIENT_SECRET_NAME=aegis-dev-oidc-secret
# AEGIS__OIDC__DISCOVERY_URL=http://localhost:8080/realms/dev/.well-known/openid-configuration
AEGIS__OIDC__JWKS_CACHE_TTL_SECONDS=60

# ── Rate Limiting (in-memory, high limits for dev iteration speed) ────────────
AEGIS__RATE_LIMIT__ENABLED=true
AEGIS__RATE_LIMIT__BACKEND=memory
AEGIS__RATE_LIMIT__REQUESTS_PER_MINUTE=10000
AEGIS__RATE_LIMIT__REQUESTS_PER_HOUR=100000
AEGIS__RATE_LIMIT__BURST_MULTIPLIER=3.0
AEGIS__RATE_LIMIT__USE_IN_MEMORY_FALLBACK=true
# Redis not required in dev; uncomment to test Redis locally
# AEGIS__RATE_LIMIT__REDIS_URL=redis://localhost:6379/0

# ── Audit (stdout only — no GCP Cloud Logging) ────────────────────────────────
AEGIS__AUDIT__ENABLED=true
AEGIS__AUDIT__LOG_NAME=aegis-ai-audit-dev
AEGIS__AUDIT__USE_GCP_LOGGING=false
AEGIS__AUDIT__USE_STRUCTURED_STDOUT=true
AEGIS__AUDIT__BATCH_SIZE=10
AEGIS__AUDIT__FLUSH_INTERVAL_SECONDS=1.0
AEGIS__AUDIT__SIGNING_KEY_SECRET_NAME=aegis-audit-signing-key-dev

# ── Encryption (GCP KMS disabled — uses local fallback key) ──────────────────
AEGIS__ENCRYPTION__KMS_KEY_NAME=
AEGIS__ENCRYPTION__ALGORITHM=AES-256-GCM
AEGIS__ENCRYPTION__KEY_CACHE_TTL_SECONDS=3600

# ── TLS ───────────────────────────────────────────────────────────────────────
AEGIS__TLS__MINIMUM_VERSION=TLSv1.2
AEGIS__TLS__PREFERRED_VERSION=TLSv1.3
AEGIS__TLS__VERIFY_CERTIFICATES=false

# ── GuardRails (relaxed for rapid iteration) ─────────────────────────────────
AEGIS__GUARDRAILS__INJECTION_THRESHOLD=0.7
AEGIS__GUARDRAILS__TOXICITY_THRESHOLD=0.9
AEGIS__GUARDRAILS__PII_BLOCK_ON_DETECTION=false
AEGIS__GUARDRAILS__MAX_PROMPT_LENGTH_CHARS=64000
AEGIS__GUARDRAILS__ENABLE_DYNAMIC_GROUNDING=false
AEGIS__GUARDRAILS__GROUNDING_MIN_SIMILARITY=0.1
AEGIS__GUARDRAILS__USE_LOCAL_TOXICITY_FALLBACK=true
AEGIS__GUARDRAILS__PERSPECTIVE_API_KEY_SECRET=aegis-perspective-key-dev

# ── Pipeline Feature Flags ────────────────────────────────────────────────────
AEGIS__PIPELINE__ENABLE_PII_MASKING=true
AEGIS__PIPELINE__ENABLE_PROMPT_INJECTION_DETECTION=true
AEGIS__PIPELINE__BLOCK_TOXIC_CONTENT=false
AEGIS__PIPELINE__ENABLE_MFA_ENFORCEMENT=false

# ── LLM Provider (use mock/stub in dev unless testing real calls) ─────────────
AEGIS__LLM__DEFAULT_PROVIDER=openai
AEGIS__LLM__DEFAULT_MODEL=gpt-4o-mini
AEGIS__LLM__REQUEST_TIMEOUT_SECONDS=60.0
AEGIS__LLM__MAX_RETRIES=1
AEGIS__LLM__OPENAI_API_KEY_SECRET=aegis-openai-key-dev
AEGIS__LLM__ANTHROPIC_API_KEY_SECRET=aegis-anthropic-key-dev
AEGIS__LLM__GOOGLE_API_KEY_SECRET=aegis-google-key-dev

# ── Observability (local OTEL collector / Jaeger) ────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis-ai-dev
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# ── Secret Backend (env-var based for dev) ────────────────────────────────────
AEGIS__SECRET_BACKEND=env
