# ─────────────────────────────────────────────────────────────────────────────
# aegis-ai · PRODUCTION Environment
# ─────────────────────────────────────────────────────────────────────────────
# Purpose : Live production environment. Maximum security posture.
# Usage   : Deploy via CI/CD with secret values injected at runtime from
#           GCP Secret Manager. This file sets NON-SECRET configuration.
#           NEVER store actual secrets (keys, passwords) in this file.
# CRITICAL: AEGIS__GCP__USE_GCP must be true. Application will refuse to
#           start if GCP is disabled in a production environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment Identity ──────────────────────────────────────────────────────
AEGIS__ENVIRONMENT=production
AEGIS__PIPELINE__ENVIRONMENT=production
AEGIS__LOG_LEVEL=WARNING

# ── GCP (full production project) ────────────────────────────────────────────
AEGIS__GCP__USE_GCP=true
AEGIS__GCP__PROJECT_ID=your-gcp-production-project-id
# Leave blank to use Workload Identity / ADC in GKE — recommended
AEGIS__GCP__SERVICE_ACCOUNT_PATH=
AEGIS__GCP__SECRET_MANAGER_PREFIX=aegis-ai
AEGIS__GCP__KMS_KEY_RING=aegis-ai-prod-keyring
AEGIS__GCP__KMS_LOCATION=us-central1
AEGIS__GCP__KMS_CRYPTO_KEY=aegis-ai-prod-key

# ── JWT (all keys from GCP Secret Manager) ────────────────────────────────────
AEGIS__JWT__ALGORITHM=RS256
AEGIS__JWT__ISSUER=https://auth.your-domain.com
AEGIS__JWT__AUDIENCE=aegis-ai-agents
AEGIS__JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15
AEGIS__JWT__REFRESH_TOKEN_EXPIRE_DAYS=7
AEGIS__JWT__PRIVATE_KEY_SECRET_NAME=aegis-jwt-private-key
AEGIS__JWT__PUBLIC_KEY_SECRET_NAME=aegis-jwt-public-key
# CRITICAL: Do NOT set LOCAL_PRIVATE_KEY_PATH or LOCAL_PUBLIC_KEY_PATH in production.
# The startup validator will reject any config that sets these in production.

# ── OIDC / SSO ────────────────────────────────────────────────────────────────
AEGIS__OIDC__PROVIDER_NAME=google
AEGIS__OIDC__CLIENT_ID=your-production-client-id.apps.googleusercontent.com
AEGIS__OIDC__CLIENT_SECRET_NAME=aegis-oidc-client-secret
AEGIS__OIDC__DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
AEGIS__OIDC__JWKS_CACHE_TTL_SECONDS=300
AEGIS__OIDC__ALLOWED_ISSUERS=["https://accounts.google.com","https://auth.your-domain.com"]

# ── Rate Limiting (Redis Cluster — high availability) ─────────────────────────
AEGIS__RATE_LIMIT__ENABLED=true
AEGIS__RATE_LIMIT__BACKEND=redis
AEGIS__RATE_LIMIT__REDIS_URL=rediss://redis-cluster.your-domain.com:6380/0
AEGIS__RATE_LIMIT__REQUESTS_PER_MINUTE=60
AEGIS__RATE_LIMIT__REQUESTS_PER_HOUR=1000
AEGIS__RATE_LIMIT__BURST_MULTIPLIER=1.5
# False: Redis outage causes 503 — no fallback to in-memory in production
AEGIS__RATE_LIMIT__USE_IN_MEMORY_FALLBACK=false

# ── Audit (GCP Cloud Logging — immutable, signed events) ─────────────────────
AEGIS__AUDIT__ENABLED=true
AEGIS__AUDIT__LOG_NAME=aegis-ai-audit
AEGIS__AUDIT__USE_GCP_LOGGING=true
AEGIS__AUDIT__USE_STRUCTURED_STDOUT=false
AEGIS__AUDIT__BATCH_SIZE=100
AEGIS__AUDIT__FLUSH_INTERVAL_SECONDS=5.0
AEGIS__AUDIT__SIGNING_KEY_SECRET_NAME=aegis-audit-signing-key

# ── Encryption (GCP KMS — production key ring, automatic key rotation) ────────
AEGIS__ENCRYPTION__KMS_KEY_NAME=projects/your-gcp-production-project-id/locations/us-central1/keyRings/aegis-ai-prod-keyring/cryptoKeys/aegis-ai-prod-key
AEGIS__ENCRYPTION__ALGORITHM=AES-256-GCM
AEGIS__ENCRYPTION__KEY_CACHE_TTL_SECONDS=300

# ── TLS (TLS 1.3 mandatory in production) ─────────────────────────────────────
AEGIS__TLS__MINIMUM_VERSION=TLSv1.3
AEGIS__TLS__PREFERRED_VERSION=TLSv1.3
AEGIS__TLS__VERIFY_CERTIFICATES=true

# ── GuardRails (strictest thresholds) ─────────────────────────────────────────
AEGIS__GUARDRAILS__INJECTION_THRESHOLD=0.4
AEGIS__GUARDRAILS__TOXICITY_THRESHOLD=0.7
AEGIS__GUARDRAILS__PII_BLOCK_ON_DETECTION=false
AEGIS__GUARDRAILS__MAX_PROMPT_LENGTH_CHARS=32000
AEGIS__GUARDRAILS__ENABLE_DYNAMIC_GROUNDING=true
AEGIS__GUARDRAILS__GROUNDING_MIN_SIMILARITY=0.3
AEGIS__GUARDRAILS__USE_LOCAL_TOXICITY_FALLBACK=false
AEGIS__GUARDRAILS__PERSPECTIVE_API_KEY_SECRET=aegis-perspective-key

# ── Pipeline Feature Flags ────────────────────────────────────────────────────
AEGIS__PIPELINE__ENABLE_PII_MASKING=true
AEGIS__PIPELINE__ENABLE_PROMPT_INJECTION_DETECTION=true
AEGIS__PIPELINE__BLOCK_TOXIC_CONTENT=true
AEGIS__PIPELINE__ENABLE_MFA_ENFORCEMENT=true

# ── LLM Provider (zero-retention approved only) ───────────────────────────────
AEGIS__LLM__DEFAULT_PROVIDER=openai
AEGIS__LLM__DEFAULT_MODEL=gpt-4o
AEGIS__LLM__REQUEST_TIMEOUT_SECONDS=30.0
AEGIS__LLM__MAX_RETRIES=3
AEGIS__LLM__OPENAI_API_KEY_SECRET=aegis-openai-key
AEGIS__LLM__ANTHROPIC_API_KEY_SECRET=aegis-anthropic-key
AEGIS__LLM__GOOGLE_API_KEY_SECRET=aegis-google-key

# ── Observability (production OTEL / Datadog / Grafana) ───────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.your-domain.com:4317
OTEL_SERVICE_NAME=aegis-ai
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ── Secret Backend ────────────────────────────────────────────────────────────
AEGIS__SECRET_BACKEND=gcp
