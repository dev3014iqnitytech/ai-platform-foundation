# ─────────────────────────────────────────────────────────────────────────────
# aegis-ai · STAGING Environment
# ─────────────────────────────────────────────────────────────────────────────
# Purpose : Pre-production validation. Mirrors production topology with
#           a separate GCP project, real Redis, and real GCP Secret Manager.
# Usage   : Set AEGIS_ENV=staging in your CI/CD pipeline or Kubernetes pod spec.
# WARNING : Secrets must come from GCP Secret Manager, not this file.
#           Ensure the staging service account has Secret Manager Secret Accessor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment Identity ──────────────────────────────────────────────────────
AEGIS__ENVIRONMENT=staging
AEGIS__PIPELINE__ENVIRONMENT=staging
AEGIS__LOG_LEVEL=INFO

# ── GCP (staging project) ─────────────────────────────────────────────────────
AEGIS__GCP__USE_GCP=true
AEGIS__GCP__PROJECT_ID=your-gcp-staging-project-id
AEGIS__GCP__SERVICE_ACCOUNT_PATH=
AEGIS__GCP__SECRET_MANAGER_PREFIX=aegis-ai-staging
AEGIS__GCP__KMS_KEY_RING=aegis-ai-staging-keyring
AEGIS__GCP__KMS_LOCATION=us-central1
AEGIS__GCP__KMS_CRYPTO_KEY=aegis-ai-staging-key

# ── JWT (secrets from GCP Secret Manager — staging versions) ──────────────────
AEGIS__JWT__ALGORITHM=RS256
AEGIS__JWT__ISSUER=https://auth.staging.your-domain.com
AEGIS__JWT__AUDIENCE=aegis-ai-staging
AEGIS__JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
AEGIS__JWT__REFRESH_TOKEN_EXPIRE_DAYS=14
AEGIS__JWT__PRIVATE_KEY_SECRET_NAME=aegis-jwt-private-key-staging
AEGIS__JWT__PUBLIC_KEY_SECRET_NAME=aegis-jwt-public-key-staging

# ── OIDC / SSO ────────────────────────────────────────────────────────────────
AEGIS__OIDC__PROVIDER_NAME=google
AEGIS__OIDC__CLIENT_ID=your-staging-client-id.apps.googleusercontent.com
AEGIS__OIDC__CLIENT_SECRET_NAME=aegis-oidc-client-secret-staging
AEGIS__OIDC__DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
AEGIS__OIDC__JWKS_CACHE_TTL_SECONDS=180
AEGIS__OIDC__ALLOWED_ISSUERS=["https://accounts.google.com"]

# ── Rate Limiting (Redis — single node staging instance) ─────────────────────
AEGIS__RATE_LIMIT__ENABLED=true
AEGIS__RATE_LIMIT__BACKEND=redis
AEGIS__RATE_LIMIT__REDIS_URL=redis://redis-staging.your-domain.com:6379/0
AEGIS__RATE_LIMIT__REQUESTS_PER_MINUTE=120
AEGIS__RATE_LIMIT__REQUESTS_PER_HOUR=5000
AEGIS__RATE_LIMIT__BURST_MULTIPLIER=2.0
AEGIS__RATE_LIMIT__USE_IN_MEMORY_FALLBACK=true

# ── Audit (GCP Cloud Logging + structured stdout) ─────────────────────────────
AEGIS__AUDIT__ENABLED=true
AEGIS__AUDIT__LOG_NAME=aegis-ai-audit-staging
AEGIS__AUDIT__USE_GCP_LOGGING=true
AEGIS__AUDIT__USE_STRUCTURED_STDOUT=true
AEGIS__AUDIT__BATCH_SIZE=50
AEGIS__AUDIT__FLUSH_INTERVAL_SECONDS=3.0
AEGIS__AUDIT__SIGNING_KEY_SECRET_NAME=aegis-audit-signing-key-staging

# ── Encryption (GCP KMS — staging key ring) ───────────────────────────────────
AEGIS__ENCRYPTION__KMS_KEY_NAME=projects/your-gcp-staging-project-id/locations/us-central1/keyRings/aegis-ai-staging-keyring/cryptoKeys/aegis-ai-staging-key
AEGIS__ENCRYPTION__ALGORITHM=AES-256-GCM
AEGIS__ENCRYPTION__KEY_CACHE_TTL_SECONDS=300

# ── TLS ───────────────────────────────────────────────────────────────────────
AEGIS__TLS__MINIMUM_VERSION=TLSv1.2
AEGIS__TLS__PREFERRED_VERSION=TLSv1.3
AEGIS__TLS__VERIFY_CERTIFICATES=true

# ── GuardRails (near-production thresholds) ───────────────────────────────────
AEGIS__GUARDRAILS__INJECTION_THRESHOLD=0.45
AEGIS__GUARDRAILS__TOXICITY_THRESHOLD=0.75
AEGIS__GUARDRAILS__PII_BLOCK_ON_DETECTION=false
AEGIS__GUARDRAILS__MAX_PROMPT_LENGTH_CHARS=32000
AEGIS__GUARDRAILS__ENABLE_DYNAMIC_GROUNDING=true
AEGIS__GUARDRAILS__GROUNDING_MIN_SIMILARITY=0.3
AEGIS__GUARDRAILS__USE_LOCAL_TOXICITY_FALLBACK=true
AEGIS__GUARDRAILS__PERSPECTIVE_API_KEY_SECRET=aegis-perspective-key-staging

# ── Pipeline Feature Flags ────────────────────────────────────────────────────
AEGIS__PIPELINE__ENABLE_PII_MASKING=true
AEGIS__PIPELINE__ENABLE_PROMPT_INJECTION_DETECTION=true
AEGIS__PIPELINE__BLOCK_TOXIC_CONTENT=true
AEGIS__PIPELINE__ENABLE_MFA_ENFORCEMENT=false

# ── LLM Provider ─────────────────────────────────────────────────────────────
AEGIS__LLM__DEFAULT_PROVIDER=openai
AEGIS__LLM__DEFAULT_MODEL=gpt-4o
AEGIS__LLM__REQUEST_TIMEOUT_SECONDS=45.0
AEGIS__LLM__MAX_RETRIES=2
AEGIS__LLM__OPENAI_API_KEY_SECRET=aegis-openai-key-staging
AEGIS__LLM__ANTHROPIC_API_KEY_SECRET=aegis-anthropic-key-staging
AEGIS__LLM__GOOGLE_API_KEY_SECRET=aegis-google-key-staging

# ── Observability (staging OTEL collector) ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-staging.your-domain.com:4317
OTEL_SERVICE_NAME=aegis-ai-staging
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.5

# ── Secret Backend ────────────────────────────────────────────────────────────
AEGIS__SECRET_BACKEND=gcp
