# Local development environment variables
# Azure AD — stub values to prevent MSAL init crash in LOCAL_MODE
# The app will show the login page; use the local token bypass instead.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_AUDIENCE=api://local-eatap

# Backend API base URL — keep empty so requests use the Vite proxy (avoids CORS)
VITE_API_BASE_URL=

# Local mode flag
VITE_LOCAL_MODE=true
