# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — GitHub Copilot API (no Azure subscription required)
#
# Prerequisites:
#   1. GitHub account with Copilot access (Individual, Business, or Enterprise)
#   2. GitHub Personal Access Token (classic or fine-grained) with:
#        - "models: read" scope  (for embeddings via GitHub Models)
#        - No extra scope needed for Copilot API completions
#      Create one at: https://github.com/settings/tokens
#   3. Docker Desktop running (for PostgreSQL + Redis)
#      → docker compose up postgres redis -d
#   4. Backend
#      → cd backend && pip install -r requirements.txt
#      → uvicorn app.main:app --reload --port 8000
#   5. Frontend (separate terminal)
#      → cd frontend && npm install && npm run dev
#   6. Get a dev token (no Azure AD needed):
#      POST http://localhost:8000/api/v1/auth/local-token
#      Body: {"email": "dev@local.dev", "roles": ["admin", "tester", "reviewer"]}
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ──────────────────────────────────────────────────────────────────────
LOCAL_MODE=true
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── Application ───────────────────────────────────────────────────────────────
APP_SECRET_KEY=local-dev-secret-must-be-at-least-32-chars!!

# ── GitHub Copilot API ────────────────────────────────────────────────────────
# Chat completions — GitHub Copilot (OpenAI-compatible endpoint)
OPENAI_API_BASE=http://127.0.0.1:3030/v1
# Embeddings — GitHub Models API (Copilot endpoint does not serve embeddings)
EMBED_API_BASE=https://models.inference.ai.azure.com
# Your GitHub Personal Access Token (ghp_... or github_pat_...)
OPENAI_API_KEY=dummy

# Model names available via GitHub Copilot / GitHub Models:
#   Chat    : gpt-4o, gpt-4.1, claude-3.7-sonnet, o3-mini
#   Mini    : gpt-4o-mini, gpt-4.1-mini
#   Embeddings: text-embedding-3-small, text-embedding-3-large (GitHub Models)
LOCAL_LLM_MODEL=gpt-5.4
LOCAL_MINI_LLM_MODEL=gpt-4o-mini
LOCAL_EMBED_MODEL=text-embedding-3-small

# ── Local JWT (HS256, no Azure AD) ────────────────────────────────────────────
LOCAL_JWT_SECRET=local-dev-jwt-secret-must-be-32chars!!
LOCAL_JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database — PostgreSQL via Docker Compose ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:5432/<db>
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# ── Cache — Redis ─────────────────────────────────────────────────────────────
# Real Redis server (started from portable binary — see below)
REDIS_URL=redis://localhost:6379/0
# Fallback: in-memory fakeredis (no server needed, data lost on restart)
# REDIS_URL=redis://fakeredis/0

# ── Vector Store ──────────────────────────────────────────────────────────────
# Azure AI Search is NOT used in LOCAL_MODE — FAISS (in-memory) is used instead.
# Leave AZURE_SEARCH_* unset.

# ── Azure OpenAI — NOT used in LOCAL_MODE ─────────────────────────────────────
# Leave AZURE_OPENAI_* unset.

# ── Azure AD — NOT used in LOCAL_MODE ─────────────────────────────────────────
# Leave AZURE_TENANT_ID / AZURE_CLIENT_ID / etc. unset.

# ── Azure DevOps — optional ───────────────────────────────────────────────────
# Leave unset to use mock/stub data. Agents return placeholder responses
# instead of fetching real work items.
ADO_ORGANIZATION=https://dev.azure.com/<ADO-ORG>
ADO_PROJECT=<ADO-Project>
ADO_PAT=<ADOPAT>

# ── Azure Service Bus — disabled (events dropped silently) ────────────────────
# Leave SERVICE_BUS_* unset.

# ── Azure Key Vault — disabled (env vars used directly) ──────────────────────
# Leave KEY_VAULT_URL unset.

# ── Azure Blob Storage — disabled ─────────────────────────────────────────────
# Leave AZURE_STORAGE_* unset.

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_SEMANTIC_CACHE=false
ENABLE_MULTI_QUERY_RETRIEVAL=false

# ── Observability (optional) ──────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your-langsmith-key

# ── Cohere reranking (optional) ───────────────────────────────────────────────
# COHERE_API_KEY=your-cohere-key


# ── Azure Blob Storage — disabled ─────────────────────────────────────────────
# Leave AZURE_STORAGE_* unset.

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Feature flags ─────────────────────────────────────────────────────────────
# Disable semantic cache so local LLM responses are always fresh during dev
ENABLE_SEMANTIC_CACHE=false
ENABLE_MULTI_QUERY_RETRIEVAL=false

# ── Observability (optional) ──────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your-langsmith-key   # uncomment to enable LangSmith tracing

# ── Cohere reranking (optional) ───────────────────────────────────────────────
# COHERE_API_KEY=your-cohere-key

# MCP SERVER
MCP_ADO_URL="http://127.0.0.1:8001"
# MCP_KB_URL="http://127.0.0.1:8002"