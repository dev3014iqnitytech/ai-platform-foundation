PYTHON_VERSION=3.12
NODE_VERSION=20

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-aoai.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-key-here
AZURE_SEARCH_INDEX_NAME=eatap-knowledge-base

# Azure AD / Authentication
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_AUDIENCE=api://your-client-id

# Azure DevOps
ADO_ORGANIZATION=https://dev.azure.com/your-org
ADO_PROJECT=YourProject
ADO_PAT=your-pat-here
ADO_API_VERSION=7.1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://eatap:eatap_password@localhost:5432/eatap_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your-redis-password

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-ns.servicebus.windows.net/;...
SERVICE_BUS_NAMESPACE=your-ns.servicebus.windows.net

# Azure Key Vault
KEY_VAULT_URL=https://your-kv.vault.azure.net/

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
AZURE_STORAGE_CONTAINER=eatap-documents

# Application
ENVIRONMENT=development
APP_SECRET_KEY=change-this-in-production-must-be-32-chars
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=eatap-backend
LOG_LEVEL=INFO

# LangSmith (optional AI tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=eatap-production

# Cohere (reranking)
COHERE_API_KEY=your-cohere-key

# Feature Flags
ENABLE_SEMANTIC_CACHE=true
ENABLE_MULTI_QUERY_RETRIEVAL=true
MAX_REVISION_COUNT=3
TOKEN_BUDGET_PER_SESSION=50000
